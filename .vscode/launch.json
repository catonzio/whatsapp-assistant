{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": "${command:pickArgs}"
        },
        {
            "name": "Python Debugger: Send test message",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts/send_test_message.py",
            "console": "integratedTerminal",
            "args": "\"ciao, aggiungi il latte alla lista\" --sender 393316239724"
        },
        {
            "name": "Python Debugger: FastAPI",
            "type": "debugpy",
            "request": "launch",
            "module": "whatsapp_assistant.main",
            "args": [
                "--webserver",
                "--host",
                "0.0.0.0",
                "--port",
                "8080",
                "--reload"
            ],
            "env": {
                // compose.yaml publishes the db container on host port 5435
                // (5432 is only reachable from other containers on the internal network).
                "DATABASE_PORT": "5435"
            },
            "jinja": true
        },
        {
            "name": "Python Debugger: ADK Web",
            "type": "debugpy",
            "request": "launch",
            "module": "google.adk.cli",
            "args": [
                "web",
                "--host",
                "0.0.0.0",
                "--port",
                "8000",
                "--session_service_uri",
                "postgresql+asyncpg://wa_ass:dev-only-local-password@localhost:5435/agent_sessions"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false
        },
    ]
}