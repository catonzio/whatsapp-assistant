{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: FastAPI",
            "type": "debugpy",
            "request": "launch",
            "module": "fastapi",
            "args": [
                "dev",
                "src/whatsapp_assistant/main.py",
                "--host",
                "0.0.0.0",
                "--port",
                "8000",
            ],
            "jinja": true
        },
        {
            "name": "Python Debugger: ADK Web",
            "type": "debugpy",
            "request": "launch",
            "module": "google.adk.cli",
            "args": [
                "web",
                "--host",
                "0.0.0.0",
                "--port",
                "8000",
                "--session_service_uri",
                "postgresql+asyncpg://wa_ass:dev-only-local-password@localhost:5432/agent_sessions"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false
        }
    ]
}