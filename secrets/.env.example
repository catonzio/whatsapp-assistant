# Copy to .env and fill in real values. .env is gitignored.

# --- WhatsApp ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# App secret from the Meta app (Settings > Basic) — used to verify the
# X-Hub-Signature-256 header on every webhook POST.
WHATSAPP_APP_SECRET=

# --- Gemini API Key ---
GEMINI_API_KEY=

# --- Postgres container (compose.yaml "db" service) ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=wa_ass
DATABASE_PASSWORD=dev-only-local-password
DATABASE_DB=whatsapp_assistant
DATABASE_DB_AGENT_SESSIONS=agent_sessions


DATABASE_PROTOCOL=postgresql+asyncpg
