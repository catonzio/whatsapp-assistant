# Copy to .env and fill in real values. .env is gitignored.

# --- WhatsApp / OpenAI (existing) ---
OPENAI_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# --- Postgres container (compose.yaml "db" service) ---
POSTGRES_USER=wa_ass
POSTGRES_PASSWORD=
POSTGRES_DB=whatsapp_assistant

# --- App DB connections (must match the Postgres credentials above) ---
DATABASE_URL=postgresql+asyncpg://wa_ass:CHANGE_ME@db:5432/whatsapp_assistant
AGENT_SESSIONS_DATABASE_URL=postgresql+asyncpg://wa_ass:CHANGE_ME@db:5432/agent_sessions
